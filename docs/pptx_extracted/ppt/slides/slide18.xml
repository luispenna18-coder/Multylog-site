r val="bg2"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat" panose="00000500000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>Dívida Líquida / EBIT</a:t></a:r></a:p><a:p><a:pPr algn="just"/><a:endParaRPr lang="pt-BR" sz="900" b="1" dirty="0"><a:solidFill><a:schemeClr val="tx1"><a:lumMod val="85000"/><a:lumOff val="15000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat"/></a:endParaRPr></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="pt-BR" sz="1100" dirty="0"><a:solidFill><a:schemeClr val="tx1"><a:lumMod val="85000"/><a:lumOff val="15000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat"/></a:rPr><a:t>Este é um dos indicadores mais críticos para empresas capitais intensivo, mostra quantos anos seriam necessários para uma empresa quitar sua dívida líquida, utilizando apenas o lucro antes de juros e impostos (EBIT) como base de geração de caixa.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="2" name="CaixaDeTexto 1"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{8F3347A5-8D9F-4314-FA3F-1813B0CE9071}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="952747" y="1405971"/><a:ext cx="6076700" cy="1015663"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="91440" tIns="45720" rIns="91440" bIns="45720" rtlCol="0" anchor="t"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="pt-BR" b="1" dirty="0"><a:solidFill><a:srgbClr val="FF0000"/></a:solidFill><a:latin typeface="Montserrat" panose="00000500000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>8. </a:t></a:r><a:r><a:rPr lang="pt-BR" sz="1400" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg2"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat" panose="00000500000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>Nível de Endividamento (Dívida Total / Patrimônio Líquido)</a:t></a:r></a:p><a:p><a:r><a:rPr lang="pt-BR" sz="800" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg2"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat" panose="00000500000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>   </a:t></a:r><a:endParaRPr lang="pt-BR" sz="1500" b="1" dirty="0"><a:solidFill><a:schemeClr val="bg2"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat" panose="00000500000000000000" pitchFamily="2" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr algn="just"/><a:r><a:rPr lang="pt-BR" sz="1100" dirty="0"><a:solidFill><a:schemeClr val="tx1"><a:lumMod val="85000"/><a:lumOff val="15000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat" panose="00000500000000000000" pitchFamily="2" charset="0"/><a:ea typeface="+mn-lt"/><a:cs typeface="+mn-lt"/></a:rPr><a:t>Um nível de endividamento moderado a alto é comum em empresas de capital intensivo, desde que a capacidade de geração de caixa operacional (EBITDA) seja robusta o suficiente para cobrir os encargos da dívida e o principal.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="CaixaDeTexto 2"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{257C16F2-B6D6-64CF-ECED-441E4041A147}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="939917" y="2390856"/><a:ext cx="6089530" cy="600164"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square" rtlCol="0"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="just"/><a:r><a:rPr lang="pt-BR" sz="1100" dirty="0"><a:solidFill><a:schemeClr val="tx1"><a:lumMod val="85000"/><a:lumOff val="15000"/></a:schemeClr></a:solidFill><a:latin typeface="Montserrat" panose="00000500000000000000" pitchFamily="2" charset="0"/></a:rPr><a:t>O objetivo é que este índice estabilize e comece a apresentar uma tendência de queda nos anos finais do período projetado, à medida que o patrimônio líquido cresce com os lucros retidos.</a:t></a:r></a:p></p:txBody></p:sp><p:graphicFrame><p:nvGraphicFramePr><p:cNvPr id="4" name="Gráfico 3"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{9EACC1E6-F233-4005-A2E6-7B8CB01A715F}"/></a:ext></a:extLst></p:cNvPr><p:cNvGraphicFramePr><a:graphicFrameLocks/></p:cNvGraphicFramePr><p:nvPr><p:extLst><p:ext uri="{D42A27DB-BD31-4B8C-83A1-F6EECF244321}"><p14:modId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="822875267"/></p:ext></p:extLst></p:nvPr></p:nvGraphicFramePr><p:xfrm><a:off x="7315200" y="2421635"/><a:ext cx="6981018" cy="5355172"/></p:xfrm><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/chart"><c:chart xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" r:id="rId3"/></a:graphicData></a:graphic></p:graphicFrame></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="164537551"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>